{
  "name": "unwedged",
  "version": "1.2.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "unwedged": "bin/unwedged.mjs"
  },
  "files": [
    "dist",
    "bin",
    "assets/demo.gif",
    "README*.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "public/unwedged-mark.svg"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "npm run build",
    "test:e2e": "playwright test",
    "test:reference": ".venv/bin/python tests/reference.py",
    "record:demo": "node scripts/record-demo.mjs",
    "test:offline": "playwright test --config=playwright.offline.config.ts",
    "smoke:package": "node scripts/package-smoke.mjs",
    "render:social-card": "node scripts/render-social-card.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
